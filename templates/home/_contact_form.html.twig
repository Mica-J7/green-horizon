{% for message in app.flashes('success') %}
    <div class="alert alert--success">{{ message }}</div>
{% endfor %}

{{ form_start(contactForm, { action: path('app_home') ~ '#contact', attr: { class: 'contact-form', novalidate: 'novalidate', 'data-action': 'submit->contact-form#submit' } }) }}
    {% if contactForm.vars.errors|length > 0 %}
        <div class="alert alert--error">{{ form_errors(contactForm) }}</div>
    {% endif %}
    {{ form_row(contactForm.name) }}
    {{ form_row(contactForm.email) }}
    {{ form_row(contactForm.phone) }}
    <div data-controller="char-counter">
        {{ form_row(contactForm.message) }}
    </div>
    <div class="consent-row">
        {{ form_widget(contactForm.consent) }}
        {{ form_label(contactForm.consent) }}
    </div>
    {{ form_errors(contactForm.consent) }}
    <button type="submit" class="btn btn--primary btn--full">Envoyer ma demande</button>
{{ form_end(contactForm) }}
